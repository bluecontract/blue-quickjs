    },
    {
      "path": "../../libs/quickjs-runtime/tsconfig.lib.json"
    },
    {
      "path": "../../libs/dv/tsconfig.lib.json"
    },
    {
      "path": "../../libs/deterministic-builder/tsconfig.lib.json"
    },
    {
      "path": "../../libs/abi-manifest/tsconfig.lib.json"
    }
  ]
