{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/out-tsc-spec",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
