 quickjs-internal.h |  11 +++
 quickjs-sha256.c   | 163 +++++++++++++++++++++++++++++++++++++++++++++
 quickjs.c          | 158 +++++++++++++++++++++++++++++++++++++++++++
 quickjs.h          |  12 ++++
 5 files changed, 345 insertions(+), 1 deletion(-)
 create mode 100644 quickjs-internal.h
 create mode 100644 quickjs-sha256.c

