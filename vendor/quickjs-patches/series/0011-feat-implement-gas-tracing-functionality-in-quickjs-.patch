--- a/quickjs.h
+++ b/quickjs.h
@@ -396,6 +396,20 @@ void JS_SetGasLimit(JSContext *ctx, uint64_t gas_limit);
 uint64_t JS_GetGasRemaining(JSContext *ctx);
